<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>McpLense</AssemblyName>
    <RootNamespace>McpLense</RootNamespace>
  </PropertyGroup>

  <PropertyGroup Label="NuGet packaging (library)">
    <PackageId>McpLense</PackageId>
    <Version>0.5.0-preview.1</Version>
    <Description>Library powering the McpLense CLI: scans MCP servers for auth surface, capabilities, TLS posture, OAuth metadata, and other facts useful for security / risk classification. Reference this package to integrate scanning into your own tooling or to register custom IScanCheck implementations.</Description>
    <PackageTags>mcp;model-context-protocol;scanning;security;library</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Azure.Identity" />
    <PackageReference Include="ModelContextProtocol" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>

  <ItemGroup Label="Internals access">
    <InternalsVisibleTo Include="McpLense.Cli" />
    <InternalsVisibleTo Include="McpLense.UnitTests" />
    <InternalsVisibleTo Include="McpLense.IntegrationTests" />
    <InternalsVisibleTo Include="McpLense.E2ETests" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
