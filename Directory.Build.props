<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>13.0</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Label="Shared package version - single source of truth">
    <!--
      Bump this property and BOTH McpLense (library) + McpLense.Cli (dotnet tool) ship at
      the same version. Per-project csproj files MUST NOT override <Version>; if they need
      package-specific overrides they should derive from $(Version) (e.g. via
      $(VersionPrefix) / $(VersionSuffix)).
    -->
    <Version>0.17.2</Version>
  </PropertyGroup>

  <PropertyGroup Label="Shared package metadata">
    <Authors>Moaid Hathot</Authors>
    <Company>Moaid Hathot</Company>
    <PackageLicenseExpression>Unlicense</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/MoaidHathot/McpLense</PackageProjectUrl>
    <RepositoryUrl>https://github.com/MoaidHathot/McpLense</RepositoryUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>

</Project>
